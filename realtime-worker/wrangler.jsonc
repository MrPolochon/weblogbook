{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weblogbook-realtime",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-23",
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "RadioRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RadioRoom"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://mixouairlinesptfsweblogbook.com,https://www.mixouairlinesptfsweblogbook.com,null,file://",
    "MAX_ROOM_MEMBERS": "100"
  }
}
