<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="4dp">
    <LinearLayout android:id="@+id/bubble_expanded" android:layout_width="160dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_bubble" android:padding="8dp" android:elevation="8dp">
        <TextView android:id="@+id/tv_frequency" android:layout_width="match_parent" android:layout_height="48dp" android:text="---.---" android:textColor="#7DD3FC" android:textSize="20sp" android:fontFamily="monospace" android:gravity="center" android:contentDescription="Déplacer la bulle radio"/>
        <TextView android:id="@+id/tv_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MICRO COUPÉ" android:textColor="#CBD5E1" android:textSize="10sp" android:gravity="center"/>
        <ImageView android:id="@+id/btn_ptt" android:layout_width="80dp" android:layout_height="80dp" android:layout_marginTop="8dp" android:src="@drawable/ic_mic_off" android:background="@drawable/bg_ptt_button" android:padding="20dp" android:contentDescription="Maintenir pour parler"/>
        <TextView android:id="@+id/btn_mute" android:layout_width="match_parent" android:layout_height="48dp" android:text="Couper le micro" android:gravity="center" android:textColor="#FCA5A5" android:clickable="true" android:focusable="true"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
            <TextView android:id="@+id/btn_minimize" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="Réduire" android:textSize="12sp" android:textColor="#CBD5E1" android:gravity="center" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/btn_off" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="OFF" android:textColor="#FCA5A5" android:gravity="center" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/bubble_collapsed" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_radio" android:background="@drawable/bg_bubble_mini" android:padding="14dp" android:visibility="gone" android:contentDescription="Ouvrir la bulle VHF" android:clickable="true" android:focusable="true"/>
</FrameLayout>
